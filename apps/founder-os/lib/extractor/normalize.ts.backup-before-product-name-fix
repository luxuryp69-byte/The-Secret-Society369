function moveProductNameToDescription(
  product: {
    name: string;
    description: string;
  },
): {
  name: string;
  description: string;
  moved: boolean;
} {
  const name =
    normalizeText(product.name);

  const description =
    normalizeText(product.description);

  if (!name) {
    return {
      name: "",
      description,
      moved: false,
    };
  }

  if (
    !looksLikeProductDescription(name)
  ) {
    return {
      name,
      description,
      moved: false,
    };
  }

  return {
    name: "",
    description:
      combineDescriptions(
        name,
        description,
      ),
    moved: true,
  };
}

