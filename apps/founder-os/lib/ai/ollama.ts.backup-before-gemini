const OLLAMA_URL =
  process.env.OLLAMA_URL ??
  "http://127.0.0.1:11434/api/generate";

const FAST_MODEL =
  process.env.OLLAMA_FAST_MODEL ??
  "gemma2:2b";

const REASONING_MODEL =
  process.env.OLLAMA_REASONING_MODEL ??
  "llama3.1:8b";

const OPENAI_FAST_MODEL =
  process.env.OPENAI_FAST_MODEL ??
  "gpt-4o-mini";

const OPENAI_REASONING_MODEL =
  process.env.OPENAI_REASONING_MODEL ??
  "gpt-4o";

const IS_VERCEL =
  process.env.VERCEL === "1";

export type ModelTier =
  | "fast"
  | "reasoning";

export type JsonSchema = {
  type:
    | "object"
    | "array"
    | "string"
    | "number"
    | "integer"
    | "boolean";
  properties?: Record<string, JsonSchema>;
  items?: JsonSchema;
  required?: string[];
  additionalProperties?: boolean;
  description?: string;
  enum?: string[];
};

export type GenerateOptions = {
  temperature?: number;
  num_predict?: number;
  model?: string;
  tier?: ModelTier;
  keep_alive?: string | number;
  format?: "json" | Record<string, unknown>;
};

type OllamaResponse = {
  response?: string;
  model?: string;
  total_duration?: number;
  load_duration?: number;
  prompt_eval_duration?: number;
  eval_duration?: number;
  prompt_eval_count?: number;
  eval_count?: number;
};

function getOllamaModel(
  options: GenerateOptions,
): string {
  if (options.model) {
    return options.model;
  }

  if (options.tier === "reasoning") {
    return REASONING_MODEL;
  }

  return FAST_MODEL;
}

function getOpenAIModel(
  options: GenerateOptions,
): string {
  if (options.model) {
    return options.model;
  }

  if (options.tier === "reasoning") {
    return OPENAI_REASONING_MODEL;
  }

  return OPENAI_FAST_MODEL;
}

function nsToSeconds(
  value?: number,
): string {
  if (!value) {
    return "0.00";
  }

  return (
    value / 1_000_000_000
  ).toFixed(2);
}

async function generateWithOllama(
  prompt: string,
  options: GenerateOptions,
): Promise<string> {
  const startedAt = Date.now();
  const model = getOllamaModel(options);

  const temperature =
    options.temperature ?? 0.2;

  const numPredict =
    options.num_predict ?? 256;

  const keepAlive =
    options.keep_alive ?? "10m";

  console.log(
    `🤖 Ollama START | model=${model} | tier=${
      options.tier ?? "fast"
    } | prompt=${prompt.length} chars | max_tokens=${numPredict}`,
  );

  try {
    const body: Record<string, unknown> = {
      model,
      prompt,
      stream: false,
      keep_alive: keepAlive,
      options: {
        temperature,
        num_predict: numPredict,
      },
    };

    if (options.format !== undefined) {
      body.format = options.format;
    }

    const response = await fetch(
      OLLAMA_URL,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
      },
    );

    if (!response.ok) {
      const errorText =
        await response.text();

      throw new Error(
        `Ollama ${response.status}: ${errorText}`,
      );
    }

    const data =
      (await response.json()) as OllamaResponse;

    const result =
      (data.response ?? "").trim();

    const elapsed =
      (
        (Date.now() - startedAt) /
        1000
      ).toFixed(2);

    console.log(
      `🤖 Ollama END | ${elapsed}s | response=${result.length} chars`,
    );

    if (
      data.load_duration !==
      undefined
    ) {
      console.log(
        `📦 Ollama LOAD | ${nsToSeconds(
          data.load_duration,
        )}s`,
      );
    }

    if (
      data.prompt_eval_duration !==
      undefined
    ) {
      console.log(
        `📥 Ollama PROMPT | ${nsToSeconds(
          data.prompt_eval_duration,
        )}s`,
      );
    }

    if (
      data.eval_duration !==
      undefined
    ) {
      console.log(
        `🧠 Ollama EVAL | ${nsToSeconds(
          data.eval_duration,
        )}s`,
      );
    }

    if (
      data.prompt_eval_count !==
      undefined
    ) {
      console.log(
        `📊 Ollama TOKENS | prompt=${
          data.prompt_eval_count
        } generated=${
          data.eval_count ?? 0
        }`,
      );
    }

    return result;
  } catch (error) {
    const elapsed =
      (
        (Date.now() - startedAt) /
        1000
      ).toFixed(2);

    console.error(
      `❌ Ollama ERROR | ${elapsed}s`,
      error,
    );

    throw error;
  }
}

async function generateWithOpenAI(
  prompt: string,
  options: GenerateOptions,
): Promise<string> {
  const startedAt = Date.now();

  const apiKey =
    process.env.OPENAI_API_KEY;

  if (!apiKey) {
    throw new Error(
      "OPENAI_API_KEY is not configured",
    );
  }

  const model =
    getOpenAIModel(options);

  const temperature =
    options.temperature ?? 0.2;

  const maxTokens =
    options.num_predict ?? 256;

  console.log(
    `🤖 OpenAI START | model=${model} | tier=${
      options.tier ?? "fast"
    } | prompt=${prompt.length} chars | max_tokens=${maxTokens}`,
  );

  try {
    const { default: OpenAI } =
      await import("openai");

    const client =
      new OpenAI({
        apiKey,
      });

    const request: Record<string, unknown> = {
      model,
      input: prompt,
      max_output_tokens: maxTokens,
    };

    if (
      model !==
      OPENAI_REASONING_MODEL
    ) {
      request.temperature =
        temperature;
    }

    if (
      options.format !== undefined
    ) {
      if (
        typeof options.format ===
        "object" &&
        options.format !== null &&
        options.format.type ===
          "object"
      ) {
        request.text = {
          format: {
            type: "json_schema",
            name: "founder_os_response",
            strict: true,
            schema: options.format,
          },
        };
      } else {
        request.text = {
          format: {
            type: "json_object",
          },
        };
      }
    }

    const response =
      await client.responses.create(
        request as Parameters<
          typeof client.responses.create
        >[0],
      );

    if (!("output_text" in response)) {
      throw new Error(
        "OpenAI returned a streaming response unexpectedly",
      );
    }

    const result =
      response.output_text.trim();

    const elapsed =
      (
        (Date.now() - startedAt) /
        1000
      ).toFixed(2);

    console.log(
      `🤖 OpenAI END | ${elapsed}s | response=${result.length} chars`,
    );

    return result;
  } catch (error) {
    const elapsed =
      (
        (Date.now() - startedAt) /
        1000
      ).toFixed(2);

    console.error(
      `❌ OpenAI ERROR | ${elapsed}s`,
      error,
    );

    throw error;
  }
}

async function generate(
  prompt: string,
  options: GenerateOptions = {},
): Promise<string> {
  if (IS_VERCEL) {
    return generateWithOpenAI(
      prompt,
      options,
    );
  }

  return generateWithOllama(
    prompt,
    options,
  );
}

export async function askFast(
  prompt: string,
  options: GenerateOptions = {},
): Promise<string> {
  return generate(
    prompt,
    {
      ...options,
      tier: "fast",
    },
  );
}

export async function askReasoning(
  prompt: string,
  options: GenerateOptions = {},
): Promise<string> {
  return generate(
    prompt,
    {
      ...options,
      tier: "reasoning",
    },
  );
}

export async function askText(
  prompt: string,
  options: GenerateOptions = {},
): Promise<string> {
  return generate(
    prompt,
    options,
  );
}

export async function askJSON(
  prompt: string,
  options: GenerateOptions = {},
): Promise<string> {
  return generate(
    prompt,
    {
      ...options,
      tier: "fast",
    },
  );
}

export const OLLAMA_MODELS = {
  fast: FAST_MODEL,
  reasoning: REASONING_MODEL,
} as const;
